# Afgebakende tentoonstelling, niet de vaste collectie of de lezing van 28 november.
# Enkel het gepubliceerde tentoonstellingsrooster; niet een bevestiging van ieder slot.
<https://www.mudel.be/activiteiten/detail/15692/albert-servaes-pionier-van-het-expressionisme> a schema:ExhibitionEvent ;
    schema:name "Albert Servaes. Pionier van het expressionisme"@nl ;
    schema:description "In het mudel, volgens het gepubliceerde tentoonstellingsrooster. Controleer extra sluitingsdagen bij het museum."@nl ;
    schema:location wd:Q2215500 ;
    schema:startDate "2026-11-21"^^xsd:date ;
    schema:endDate "2027-05-16"^^xsd:date ;
    schema:eventSchedule [ a schema:Schedule ;
        schema:startDate "2026-11-21"^^xsd:date ;
        schema:endDate "2027-05-16"^^xsd:date ;
        schema:repeatFrequency "P1W"^^xsd:duration ;
        schema:scheduleTimezone "Europe/Brussels" ;
        schema:byDay schema:Tuesday, schema:Wednesday, schema:Thursday, schema:Friday, schema:Saturday, schema:Sunday ;
        schema:startTime "11:00:00"^^xsd:time ;
        schema:endTime "17:00:00"^^xsd:time ;
        # Vier gepubliceerde sluitingsdagen; laat ook onzekere feestdagen weg.
        schema:exceptDate "2026-12-24"^^xsd:date, "2026-12-25"^^xsd:date, "2026-12-26"^^xsd:date, "2026-12-31"^^xsd:date,
            "2027-01-01"^^xsd:date, "2027-03-28"^^xsd:date, "2027-05-01"^^xsd:date, "2027-05-06"^^xsd:date
    ] ;
    schema:url <https://www.mudel.be/activiteiten/detail/15692/albert-servaes-pionier-van-het-expressionisme> ;
    dcterms:source <https://www.mudel.be/activiteiten/detail/15692/albert-servaes-pionier-van-het-expressionisme>,
        <https://www.mudel.be/contact/24/museum-van-deinze-en-de-leiestreek> .

