@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<> a schema:Dataset ;
    schema:about wd:Q239 ;
    dcterms:source <https://nl.wikipedia.org/wiki/Lijst_van_Belgische_steden> .

wd:Q239 a schema:City ;
    schema:name "Brussel"@nl, "Bruxelles"@fr ;
