        schema:name "Vanop de openbare weg te bekijken"@nl ;
        schema:value true
    ] ;
    schema:url <https://territoire.wallonie.be/fr/liendoc/BC_PAT/56011-CLT-0007-01> ;
    dcterms:source <https://territoire.wallonie.be/fr/liendoc/BC_PAT/56011-CLT-0007-01>, <https://whc.unesco.org/fr/list/0943/cartes/> .

