<#winterwonderkasteel-2026> a schema:Event ;
    schema:name "Winterwonderkasteel"@nl ;
    schema:genre "Erfgoed"@nl ;
    schema:description "Winters bezoek aan het Gravensteen met het Joelfeest als thema. De gewone toegangstarieven gelden. Gesloten op 24, 25 en 31 december en 1 januari."@nl ;
    schema:location wd:Q950300 ;
    schema:startDate "2026-12-05"^^xsd:date ;
    schema:endDate "2027-01-03"^^xsd:date ;
    schema:eventSchedule _:gravensteenWinterSchedule ;
    schema:url <https://visit.gent.be/nl/agenda/winterwonderkasteel> ;
    dcterms:source <https://historischehuizen.stad.gent/nl/gravensteen/bezoek/winterwonderkasteel-2026> .

