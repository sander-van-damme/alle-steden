# Both visitor options share published opening days, but not precise daily hours.
_:gravensteenWinterSchedule a schema:Schedule ;
    schema:startDate "2026-12-05"^^xsd:date ;
    schema:endDate "2027-01-03"^^xsd:date ;
    schema:repeatFrequency "P1W"^^xsd:duration ;
    schema:scheduleTimezone "Europe/Brussels" ;
    schema:byDay schema:Monday, schema:Tuesday, schema:Wednesday, schema:Thursday, schema:Friday, schema:Saturday, schema:Sunday ;
    schema:exceptDate "2026-12-24"^^xsd:date, "2026-12-25"^^xsd:date, "2026-12-31"^^xsd:date, "2027-01-01"^^xsd:date .

