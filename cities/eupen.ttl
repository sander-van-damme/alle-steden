    schema:name "Voormalig stadhuis van Eupen"@nl, "Ehemaliges Rathaus"@de ;
    schema:description "Het voormalige stadhuis aan Rathausplatz 14. Je kunt de gevel vanaf het plein bekijken."@nl ;
    schema:containedInPlace wd:Q151831 ;
    schema:address [ a schema:PostalAddress ; schema:streetAddress "Rathausplatz 14" ; schema:addressLocality "Eupen" ] ;
    schema:url <https://eupenlives.be/nl/186-rathaus> ;
    dcterms:source <https://eupenlives.be/nl/186-rathaus>,
        <https://ostbelgienkulturerbe.be/desktopdefault.aspx/tabid-3557/?back=0&catid=7&linkid=31138> .

# Eén editie met verschillende daguren; geen doorlopend bezoekvenster.
